# ==============================================================================
# AiStackOps - Universal OpenStack Configuration Template
# ==============================================================================
# Copy this file to `.env` (or run `./osctl init`) and fill in your OpenStack
# credentials. Keep permissions restricted (`chmod 600 .env`).
# ==============================================================================

# 1. OpenStack Horizon Web Panel URL (HTTPS port 443)
OS_HORIZON_URL="https://your-openstack-horizon.example.com"

# 2. Optional Keystone Auth URL (if using direct Keystone API or openrc)
OS_AUTH_URL="https://your-keystone.example.com:5000/v3"

# 3. User Credentials
OS_USERNAME="your_username"
OS_PASSWORD="YOUR_PASSWORD_HERE"
OS_USER_DOMAIN_NAME="Default"

# 4. Project / Region Scope (auto-detected by Horizon session if left empty)
OS_PROJECT_NAME=""
OS_PROJECT_ID=""
OS_PROJECT_DOMAIN_ID="default"
OS_REGION_NAME="default"

# 5. Connection & Security Options
OS_VERIFY_SSL="true"
OS_TIMEOUT="30"
OS_PROXY=""
